11 dict begin
/FontType 1 def
/FontMatrix [0.001 0 0 0.001 0 0 ]readonly def
/FontName /DAAUWR+CMSY8 def
/FontBBox {-30 -955 1185 779 }readonly def
/PaintType 0 def

11 dict begin
/FontType 1 def
/FontMatrix [0.001 0 0 0.001 0 0 ]readonly def
/FontName /LYMWTH+CMSY10 def
/FontBBox {-29 -960 1116 775 }readonly def
/PaintType 0 def

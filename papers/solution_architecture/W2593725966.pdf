<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<meta name="turnstile-gate" content="challenge">
<title>Checking your browser</title>
<style>
:root { color-scheme: light dark; --bg: #f7f7f4; --fg: #1f2328; --muted: #57606a; --accent: #024731; }
@media (prefers-color-scheme: dark) { :root { --bg: #16181b; --fg: #e6edf3; --muted: #9aa4ad; --accent: #6fcf97; } }
* { box-sizing: border-box; }
body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--bg); color: var(--fg);
       font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
main { width: 100%; max-width: 34rem; padding: 2rem 1rem; text-align: center; }
h1 { font-size: 1.5rem; line-height: 1.3; margin: 0 0 .75rem; }
p { margin: .5rem 0; }
#widget { min-height: 70px; display: flex; justify-content: center; margin: 1.5rem 0 .75rem; }
#status { min-height: 1.55em; }
.muted { color: var(--muted); font-size: .875rem; }
a { color: var(--accent); }
code { white-space: nowrap; }
</style>
</head>
<body>
<main>
<h1>Checking your browser</h1>
<p>We're running this quick check to keep automated scrapers from overloading the site. It usually finishes on its own within a few seconds.</p>
<div id="widget"></div>
<p id="status" class="muted" role="status" aria-live="polite">Checking…</p>
<noscript><p><strong>This check needs JavaScript.</strong> Turn on JavaScript for this site, then reload the page.</p></noscript>
<p class="muted">Having trouble? Contact <a href="mailto:sspace@hawaii.edu">sspace@hawaii.edu</a>.</p>
<p class="muted">The check uses <a href="https://www.cloudflare.com/application-services/products/turnstile/">Cloudflare Turnstile</a>.</p>
</main>
<script>
(() => {
  const SITEKEY = "0x4AAAAAADqe17NAqi7LBN6J";
  const MSG = {"checking":"Checking…","click":"Tick the box above to continue.","verifying":"Verifying…","done":"Done. Loading the page…","retry":"That did not work. Trying again…","error":"The check ran into a problem. Trying again…","failed":"We could not verify your browser. Reload the page to try again.","busy":"Too many attempts from your network. Wait a minute, then reload the page.","cookies":"This check needs cookies. Allow cookies for this site, then reload the page.","stuck":"Your browser passed the check but did not keep the result. Allow cookies for this site, or try another network, then reload.","blocked":"The check could not load. If you use a content or script blocker, allow challenges.cloudflare.com, then reload.","unsupported":"Your browser is not supported by the check. Try an up-to-date browser."};
  const TRIES = 3;
  const status = document.getElementById('status');
  const say = key => { status.textContent = MSG[key]; };
  // Loop guard: passing again and again within two minutes means the pass
  // cookie is not being kept (cookies blocked, or the address keeps changing).
  const KEY = 'turnstile-gate-passes';
  let passes = [];
  try { passes = JSON.parse(sessionStorage.getItem(KEY) || '[]').filter(t => Date.now() - t < 120000); } catch {}
  let widget = null, rejected = 0, errors = 0, stopped = false;
  if (!navigator.cookieEnabled) { say('cookies'); stopped = true; }
  else if (passes.length >= 3) { say('stuck'); stopped = true; }

  // Stop trying and say why. removeWidget: when the widget shows Cloudflare's
  // "Success!", take it away so it does not contradict the message.
  function stop(key, removeWidget) {
    stopped = true;
    if (removeWidget && widget !== null) { try { window.turnstile.remove(widget); } catch {} }
    say(key);
  }

  // The widget passed: ask our server to confirm the token.
  async function passed(token) {
    say('verifying');
    try {
      const r = await fetch('/.turnstile-gate/verify', {
        method: 'POST', credentials: 'same-origin', cache: 'no-store',
        headers: { 'content-type': 'application/json' }, body: JSON.stringify({ token }),
      });
      if (r.ok) {
        passes.push(Date.now());
        try { sessionStorage.setItem(KEY, JSON.stringify(passes)); } catch {}
        say('done');
        location.reload();
        return;
      }
      if (r.status === 429) { stop('busy', true); return; }
    } catch {}
    // Turned down (or no answer): try again with a fresh token, up to TRIES.
    if (++rejected < TRIES) { say('retry'); window.turnstile.reset(widget); } else stop('failed', true);
  }

  // The widget itself failed: Cloudflare judged the browser a bot, or could
  // not finish. We retry (retry: 'never' turns off Cloudflare's endless
  // automatic retries) so we can stop after TRIES and say so. The widget
  // keeps its own failure notice and Troubleshoot link.
  function errored() {
    if (stopped) return;
    if (++errors < TRIES) {
      say('error');
      setTimeout(() => { if (!stopped) window.turnstile.reset(widget); }, 2500);
    } else {
      stop('failed', false);
    }
  }

  window.turnstileGateLoad = () => {
    if (stopped) return;
    widget = window.turnstile.render('#widget', {
      sitekey: SITEKEY, action: 'gate', theme: 'auto', language: 'auto', retry: 'never',
      callback: passed,
      'error-callback': errored,
      'before-interactive-callback': () => say('click'),
      'after-interactive-callback': () => say('checking'),
      'timeout-callback': () => { say('click'); window.turnstile.reset(widget); },
      'expired-callback': () => window.turnstile.reset(widget),
      'unsupported-callback': () => stop('unsupported', false),
    });
  };
  window.turnstileGateBlocked = () => say('blocked');
})();
</script>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&amp;onload=turnstileGateLoad" async defer onerror="turnstileGateBlocked()"></script>
</body>
</html>

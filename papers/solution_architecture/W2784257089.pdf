<div class="article-detail-p">
    <div class="container">
        <div class="row">
            <div class="col-md-8 LS">
                <div class="outer-cover">
                    <p class="volume"><span>Year:</span> 2017, <span>Volume:</span> 2, <span>Issue:</span> 2, <span>Page:</span> 40-54</p>
                    <ul class="tags-list">
                        <li class="tag1">Open Access</li>

q;title&q;:&q;Business, Management &a; Accounting XX21&q;,&q;identifiers&q;:{&q;collectionId&q;:&q;HSS-BUSINESS-XX21&q;},&q;subType&q;:&q;Sales Collection&q;}],&q;permissions&q;:[{&q;name&q;:&q;rfm&q;,&q;code&q;:&q;CTMRFM&q;,&q;text&q;:&q;Ready For Market&q;,&q;type&q;:&q;sales&q;,&q;description&q;:null,&q;validTo&q;:null,&q;validFrom&q;:null},{&q;name&q;:&q;EBRALL&q;,&q;code&q;:&q;EBRALL&q;,&q;text&q;:&q;Institutional, retail and Atypon&q;,&q;type&q;:&q;access&q;,&q;description&q;:null,&q;validTo&q;:null,&q;validFrom&q;:null},{&q;name&q;:&q;NORIGHTSMOB&q;,&q;code&q;:&q;NORIGHTSMOB&q;,&q;text&q;:&q;No Mobi&q;,&q;type&q;:&q;access&q;,&q;description&q;:null,&q;validTo&q;:null,&q;validFrom&q;:null}],&q;rights&q;:[],&q;chapter&q;:{&q;pageStart&q;:&q;133&q;,&q;pageEnd&q;:&q;150&q;,&q;license&q;:null,&q;fundingGroups&q;:[{&q;fundingStatement&q;:null,&q;awardGroupDetails&q;:[{&q;name&q;:&q;funderName&q;,&q;value&q;:null}]}],&q;subtitle&q;:null,&q;description&q;:null,&q;publisherImprint&q;:&q;Routledge&q;,&q;publicationDate&q;:&q;2020-04-08T00:00:00.000Z&q;,&q;copyright&q;:{&q;holder&q;:&q;selection and editorial matter, Robert D. Galliers, Dorothy E. Leidner and Boyka Simeonova; individual chapters, the contributors&q;,&q;year&q;:2020,&q;statement&q;:&q;© 2020 selection and editorial matter, Robert D. Galliers, Dorothy E. Leidner and Boyka Simeonova; individual chapters, the contributors&q;},&q;edition&q;:5,&q;doiRegistrationStatus&q;:false,&q;firstPublishedYear&q;:&q;2020&q;,&q;plannedPublicationDate&q;:&q;2020-04-27T00:00:00.000Z&q;,&q;abstracts&q;:[{&q;type&q;:&q;xml&q;,&q;position&q;:0,&q;caption&q;:null,&q;transcript&q;:null,&q;textType&q;:&q;abstract&q;,&q;value&q;:&q;&l;p&g;\n                        &l;italic&g;New digital technologies present both game-changing opportunities for—and existential threats to—companies whose success was built in the pre-digital economy. This article describes our findings from a study of 25 companies that were embarking on digital transformation journeys. We identified two digital strategies—customer engagement and digitized solutions—that provide direction for a digital transformation. Two technology-enabled assets are essential for executing those strategies: an operational backbone and a digital services platform. We describe how a big old company can combine these elements to navigate its digital transformation.&l;/italic&g;\n                     &l;/p&g;&q;}],&q;citation&q;:&q;Sebastian, I.M., Ross, J.W., Beath, C., Mocker, M., Moloney, K.G., &a; Fonstad, N.O. (2020). How Big Old Companies Navigate Digital Transformation. Strategic Information Management: Theory and Practice (5th ed., pp. 133-150). Routledge. https://doi.org/10.4324/9780429286797-6&q;,&q;textType&q;:&q;Textbook (Standard) (DRM-Free)&q;},&q;identifiers&q;:{&q;doi&q;:&q;10.4324/9780429286797-6&q;,&q;chapterId&q;:&q;chapter6&q;,&q;sku&q;:null},&q;isFree&q;:false,&q;associatedMedia&q;:[{&q;_id&q;:&q;2637f8fd-ef64-4a5f-b2ba-e1f414968918&q;,&q;type&q;:&q;chapterabstractxml&q;,&q;size&q;:1039,&q;location&q;:null},{&q;_id&q;:&q;cad78223-2eda-4d29-b7dd-e2422b694754&q;,&q;type&q;:&q;chapterabstractxml&q;,&q;size&q;:837,&q;location&q;:null},{&q;_id&q;:&q;bc0e02af-c121-45fd-b7df-122013f4d081&q;,&q;type&q;:&q;chapterpdf&q;,&q;size&q;:137225,&q;location&q;:null},{&q;_id&q;:&q;e45b1fb1-677d-4118-9572-44f9f199c18e&q;,&q;type&q;:&q;coverimage&q;,&q;size&q;:565979,&q;location&q;:&q;https://images.tandf.co.uk/common/jackets/crclarge/978042928/9780429286797.jpg&q;},{&q;_id&q;:&q;f89f7432-e0e9-434f-8901-6408b8f1b6ab&q;,&q;type&q;:&q;dbitsxml&q;,&q;size&q;:110486,&q;location&q;:null}],&q;availability&q;:[{&q;name&q;:&q;EDI-EBSCO&q;,&q;status&q;:[&q;INVALID&q;],&q;errors&q;:[&q;INVALID_FORMAT&q;],&q;type&q;:&q;product&q;},{&q;name&q;:&q;EDI-Apollo&q;,&q;status&q;:[&q;INVALID&q;],&q;errors&q;:[&q;INVALID_FORMAT&q;],&q;type&q;:&q;product&q;},{&q;name&q;:&q;DigitalScience&q;,&q;status&q;:[&q;VALID&q;],&q;errors&q;:[],&q;type&q;:&q;content&q;},{&q;nam